BIBLEQL_API_KEY=bql_live_your_key_here
UNSPLASH_ACCESS_KEY=unsplash_access_key

# Assistant's local models via Ollama (optional; these are the defaults).
# OLLAMA_URL is where Ollama listens; OLLAMA_MODEL is the model the picker
# offers while Ollama can't be reached (when it can, it lists what's pulled).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
